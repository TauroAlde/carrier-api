# PostgreSQL connection for local development
DATABASE_URL=postgres://carrier:carrier@localhost:5432/carrier_api_dev

# Separate database for the integration tests (it gets wiped on every run)
TEST_DATABASE_URL=postgres://carrier:carrier@localhost:5432/carrier_api_test

PORT=3000

# Comma-separated list of front-end origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
